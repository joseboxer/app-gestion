# SQLite (desarrollo, sin Docker)
DATABASE_URL="file:./dev.db"

# PostgreSQL (producción, con Docker: docker compose up -d)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_gestion"
JWT_SECRET="cambiar-por-secret-seguro-en-produccion"
PORT=4000
NODE_ENV=development

# Ruta base para almacenar visuales del catálogo (Excel/PDF). Por defecto: uploads/productos-catalogo
# PRODUCTOS_CATALOG_PATH=/ruta/absoluta/productos-catalogo
